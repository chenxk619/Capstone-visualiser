#TutorialOverlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

#TutorialMaskTop,
#TutorialMaskBottom,
#TutorialMaskLeft,
#TutorialMaskRight {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.65);
}

#TutorialHighlight {
    position: absolute;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: yellow;
    border-right-color: yellow;
    border-top-color: yellow;
    border-bottom-color: yellow;
    background-color: rgba(0, 0, 0, 0);
    display: none;
}

#TutorialTextPanel {
    position: absolute;
    width: 300px;
    height: 210px;
    background-color: rgba(0, 0, 0, 0.88);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
    display: none;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
}

#TutorialTitle {
    display: flex;
    min-height: 24px;
    font-size: 16px;
    color: white;
    unity-font-style: bold;
    -unity-text-align: upper-left;
    margin-bottom: 6px;
}

#TutorialBody {
    display: flex;
    min-height: 48px;
    font-size: 12px;
    color: white;
    white-space: normal;
    -unity-text-align: upper-left;
    margin-bottom: 8px;
}

#TutorialMediaImage {
    display: none;
    width: 100%;
    height: 90px;
    flex-grow: 0;
    margin-bottom: 0;
    unity-background-scale-mode: scale-to-fit;
    background-color: rgba(255, 255, 255, 0.04);
}

#TutorialNextButton {
    position: absolute;
    width: 170px;
    height: 80px;
    font-size: 10px;
    color: white;
    background-color: rgb(120, 120, 120);
    display: none;
}

#TutorialPrevButton {
    position: absolute;
    width: 170px;
    height: 80px;
    font-size: 10px;
    color: white;
    background-color: rgb(120, 120, 120);
    display: none;
}