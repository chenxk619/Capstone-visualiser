#TutorialOverlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

#TutorialMaskTop,
#TutorialMaskBottom,
#TutorialMaskLeft,
#TutorialMaskRight {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.65);
}

#TutorialHighlight {
    position: absolute;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: yellow;
    border-right-color: yellow;
    border-top-color: yellow;
    border-bottom-color: yellow;
    background-color: rgba(0, 0, 0, 0);
    display: none;
}

#TutorialArrow {
    position: absolute;
    font-size: 22px;
    color: yellow;
    unity-font-style: bold;
    display: none;
}

#TutorialTextPanel {
    position: absolute;
    width: 220px;
    min-height: 110px;
    background-color: rgba(0, 0, 0, 0.88);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    display: none;
    flex-direction: column;
}

#TutorialTitle {
    font-size: 14px;
    color: white;
    unity-font-style: bold;
    margin-bottom: 6px;
}

#TutorialBody {
    font-size: 10px;
    color: white;
    white-space: normal;
    margin-bottom: 6px;
}

#TutorialNextButton {
    position: absolute;
    width: 80px;
    height: 30px;
    font-size: 11px;
}

#TutorialCloseButton {
    width: 80px;
    height: 26px;
    font-size: 10px;
    margin-top: 6px;
}